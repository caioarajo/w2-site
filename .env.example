# Copie para .env.local (uso local). Na Vercel, cadastre em Settings → Environment Variables,
# separando os valores de "Preview" (homologação) e "Production".

# URL pública do site (metadata, sitemap, Open Graph).
# Produção: https://w2comunicacao.com.br | Homologação: https://homolog.w2comunicacao.com.br
NEXT_PUBLIC_SITE_URL=

# Ambiente. Na Vercel NÃO precisa: ela já informa production/preview sozinha.
# Fora da Vercel use: production | homolog
# SITE_ENV=homolog

# Supabase: guarda os contatos do formulário na tabela "leads".
# Painel do projeto → Project Settings → API (ou API Keys).
# A chave secreta (service_role / sb_secret_...) é SÓ do servidor: nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (opcional): também avisa por e-mail a cada contato.
RESEND_API_KEY=
CONTACT_TO=contato@w2comunicacao.com.br
CONTACT_FROM=Site W2 <site@w2comunicacao.com.br>

# Google Analytics 4: carrega só em produção e só após o consentimento de cookies.
NEXT_PUBLIC_GA_ID=
